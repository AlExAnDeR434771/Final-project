# База данных олимпиад (CSV)
import csv
import os

CSV_FILE = "data/olympiads.csv"
FIELDNAMES = ["filter_tag", "name", "description", "url"]

class OlympiadsDatabase:
    def __init__(self):
        self._init_db()

    def _init_db(self):
        os.makedirs(os.path.dirname(CSV_FILE), exist_ok=True)
        if not os.path.exists(CSV_FILE):
            with open(CSV_FILE, "w", encoding="utf-8", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=FIELDNAMES)
                writer.writeheader()

    def save_olympiads(self, filter_tag: str, data_list: list[tuple]):

# Сохраняет олимпиады с привязкой к фильтру.
        print(f"💾 Сохранение в кэш: фильтр='{filter_tag}', записей={len(data_list)}")

# Читаем существующие записи для этого фильтра
        existing = set()
        if os.path.exists(CSV_FILE):
            with open(CSV_FILE, "r", encoding="utf-8", newline="") as f:
                for r in csv.DictReader(f):
                    if r.get("filter_tag") == filter_tag:
                        existing.add(r["name"].lower())

# Удаляем старые записи этого фильтра (чтобы не было дублей при обновлении)
        self._clear_filter_cache(filter_tag)

# Добавляем новые записи
        saved = 0
        with open(CSV_FILE, "a", encoding="utf-8", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=FIELDNAMES)
            for name, desc, url in data_list:
                writer.writerow({
                    "filter_tag": filter_tag,
                    "name": name,
                    "description": desc,
                    "url": url
                })
                saved += 1

        print(f"✅ Сохранено: {saved} записей для фильтра '{filter_tag}'")
        return saved

    def _clear_filter_cache(self, filter_tag: str):
# Удаляет старые записи для данного фильтра перед обновлением
        if not os.path.exists(CSV_FILE):
            return

        rows = []
        with open(CSV_FILE, "r", encoding="utf-8", newline="") as f:
            for row in csv.DictReader(f):
                if row.get("filter_tag") != filter_tag:
                    rows.append(row)

        with open(CSV_FILE, "w", encoding="utf-8", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=FIELDNAMES)
            writer.writeheader()
            writer.writerows(rows)

    def get_olympiads(self, filter_tag: str) -> list[tuple]:
# Получает олимпиады по точному совпадению тега фильтра
        result = []
        if not os.path.exists(CSV_FILE):
            return result

        with open(CSV_FILE, "r", encoding="utf-8", newline="") as f:
            for r in csv.DictReader(f):
# Точное сравнение тега (без обрезки пробелов!)
                if r.get("filter_tag") == filter_tag:
                    result.append((r["name"], r["description"], r.get("url", "")))

        print(f"📥 Из кэша: {len(result)} записей для '{filter_tag}'")
        return result

    def update_url(self, filter_tag: str, name: str, url: str):
# Обновляет URL для конкретной олимпиады
        if not os.path.exists(CSV_FILE):
            return

        rows, updated = [], False
        with open(CSV_FILE, "r", encoding="utf-8", newline="") as f:
            for row in csv.DictReader(f):
                if row["filter_tag"] == filter_tag and row["name"] == name and not row.get("url"):
                    row["url"] = url
                    updated = True
                rows.append(row)

        if updated:
            with open(CSV_FILE, "w", encoding="utf-8", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=FIELDNAMES)
                writer.writeheader()
                writer.writerows(rows)
            print(f"✅ URL обновлён: {name}")

# Функции совместимости
_db = None

def _get_db():
    global _db
    if _db is None:
        _db = OlympiadsDatabase()
    return _db

def init():
    _get_db()._init_db()

def save_olympiads(tag, data):
    return _get_db().save_olympiads(tag, data)

def get_olympiads(tag):
    return _get_db().get_olympiads(tag)

def update_url(tag, name, url):
    return _get_db().update_url(tag, name, url)

def get_olympiads(filter_tag: str) -> list[tuple]:
    return _get_db().get_olympiads(filter_tag)

def update_url(filter_tag: str, name: str, url: str):
    _get_db().update_url(filter_tag, name, url)
