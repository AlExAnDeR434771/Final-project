# База данных пользователей (CSV)
import csv, os
from crypto.encrypt import encrypt_kuznyechik

CSV_FILE = "data/users.csv"

class UsersDatabase:
    def __init__(self): self._init_db()
    def _init_db(self):
        os.makedirs(os.path.dirname(CSV_FILE), exist_ok=True)
        if not os.path.exists(CSV_FILE):
            with open(CSV_FILE, "w", encoding="utf-8", newline="") as f:
                csv.writer(f).writerow(["login", "password_hash", "fullname_enc", "dob_enc"])

    def user_exists(self, login: str) -> bool:
        with open(CSV_FILE, "r", encoding="utf-8", newline="") as f:
            return any(row.get("login") == login for row in csv.DictReader(f))

    def save_user(self, login: str, pwd_hash: str, fio: str, dob: str):
        if not self.user_exists(login):
            with open(CSV_FILE, "a", encoding="utf-8", newline="") as f:
                csv.writer(f).writerow([login, pwd_hash, encrypt_kuznyechik(fio), encrypt_kuznyechik(dob)])

    def get_stored_hash(self, login: str) -> str:
        with open(CSV_FILE, "r", encoding="utf-8", newline="") as f:
            for row in csv.DictReader(f):
                if row.get("login") == login: return row.get("password_hash", "")
        return ""

    def get_user_data(self, login: str, field: str) -> str:
        with open(CSV_FILE, "r", encoding="utf-8", newline="") as f:
            for row in csv.DictReader(f):
                if row.get("login") == login: return row.get(field, "")
        return ""

_db = None
def _get_db():
    global _db
    if _db is None: _db = UsersDatabase()
    return _db
def init(): _get_db()._init_db()
def user_exists(login): return _get_db().user_exists(login)
def save_user(login, pwd_hash, fio, dob): return _get_db().save_user(login, pwd_hash, fio, dob)
def get_stored_hash(login): return _get_db().get_stored_hash(login)
def get_user_data(login, field): return _get_db().get_user_data(login, field)
