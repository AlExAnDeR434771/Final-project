# Главный класс приложения
import customtkinter as ctk
import tkinter as tk
import os
import traceback
from .windows.login_win import LoginWindow
from .windows.main_win import MainWindow
from logic.profile import ProfileService


class SSORApp:
    def __init__(self):
        try:
            print("🔧 Инициализация SSORApp...")
            self.root = ctk.CTk()
            self._setup_window()
            self.profile_service = ProfileService()
            self.current_user = None
            print("✅ SSORApp инициализирован")
            self._show_login()
            self.root.update()
            self.root.deiconify()
            print("✅ Окно показано")
        except Exception as e:
            print(f"❌ Ошибка в __init__: {e}")
            traceback.print_exc()

    def _setup_window(self):
        self.root.title("SSOR — Поиск олимпиад")
        self.root.geometry("900x650")
        self.root.minsize(800, 550)
        self.root.configure(fg_color="#1a3a52")

        # Установка иконки
        self._set_icon()

        from .styles.theme import apply_theme
        apply_theme()

    def _set_icon(self):
        """Установка иконки (приоритет ICO для Windows)"""
        base_dir = os.path.dirname(__file__)
        # Ищем icon.ico в корневой папке (на уровень выше gui)
        ico_path = os.path.abspath(os.path.join(base_dir, '..', 'icon.ico'))
        png_path = os.path.abspath(os.path.join(base_dir, '..', 'icon.png'))

        # 1. Пробуем ICO (надежно для Windows)
        if os.path.exists(ico_path):
            try:
                self.root.iconbitmap(ico_path)
                print("✅ ICO иконка установлена")
                return
            except Exception as e:
                print(f"⚠️ Ошибка ICO: {e}")

        # 2. Fallback на PNG
        if os.path.exists(png_path):
            try:
                img = tk.PhotoImage(file=png_path)
                self.root.iconphoto(True, img)
                self.root.icon_image = img  # Защита от сборщика мусора
                print("✅ PNG иконка установлена (может не отобразиться в заголовке)")
            except Exception as e:
                print(f"❌ Ошибка PNG: {e}")
        else:
            print("⚠️ Файл icon.ico не найден. Иконка не изменится.")

    def _show_login(self):
        try:
            if hasattr(self, 'main_window') and hasattr(self.main_window, 'frame'):
                self.main_window.frame.destroy()
            print("🔐 Показываем окно входа...")
            self.login_window = LoginWindow(
                parent=self.root,
                on_success=self._on_auth_success,
                profile_service=self.profile_service
            )
            self.root.update()
        except Exception as e:
            print(f"❌ Ошибка окна входа: {e}")
            traceback.print_exc()

    # Исправлено: user_data (без пробела и подчеркивания)
    def _on_auth_success(self, user_data: dict):
        try:
            print(f"🎉 Аутентификация успешна: {user_data.get('login', 'unknown')}")
            self.current_user = user_data
            if user_data.get("is_existing"):
                try:
                    fio = self.profile_service.load_fio(user_data["login"])
                    user_data["fio"] = fio
                except Exception:
                    user_data["fio"] = user_data.get("login", "Пользователь")
            self._show_main_window(user_data)
        except Exception as e:
            print(f"❌ Ошибка в _on_auth_success: {e}")
            traceback.print_exc()

    # Исправлено: user_data (без пробела и подчеркивания)
    def _show_main_window(self, user_data: dict = None):
        try:
            if user_data is None:
                user_data = {}
            if hasattr(self, 'login_window') and hasattr(self.login_window, 'frame'):
                self.login_window.frame.destroy()
            self.main_window = MainWindow(
                parent=self.root,
                user=user_data,
                on_logout=self._on_logout
            )
            self.root.update()
        except Exception as e:
            print(f"❌ Ошибка главного окна: {e}")
            traceback.print_exc()

    def _on_logout(self):
        try:
            print("🚪 Выход...")
            self.current_user = None
            if hasattr(self, 'main_window') and hasattr(self.main_window, 'frame'):
                self.main_window.frame.destroy()
            self._show_login()
        except Exception as e:
            print(f"❌ Ошибка выхода: {e}")
            traceback.print_exc()

    def run(self):
        print("🚀 Запуск mainloop...")
        self.root.mainloop()
