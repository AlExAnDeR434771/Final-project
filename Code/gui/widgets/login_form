# Форма ввода данных (Логин, Пароль, ФИО, Дата)
import customtkinter as ctk

class LoginForm(ctk.CTkFrame):
    def __init__(self, master):
        super().__init__(master, fg_color="#0d2137")

        # Логин
        ctk.CTkLabel(
            self, text="Логин:",
            font=ctk.CTkFont(size=12, weight="bold"),
            text_color="#7ec8e3"
        ).grid(row=0, column=0, sticky="w", pady=8, padx=10)
        self.entry_login = ctk.CTkEntry(
            self, width=350, height=40,
            font=ctk.CTkFont(size=13)
        )
        self.entry_login.grid(row=0, column=1, pady=8, padx=10)

        # Пароль 1
        ctk.CTkLabel(
            self, text="Пароль:",
            font=ctk.CTkFont(size=12, weight="bold"),
            text_color="#7ec8e3"
        ).grid(row=1, column=0, sticky="w", pady=8, padx=10)
        frame_pass = ctk.CTkFrame(self, fg_color="transparent")
        frame_pass.grid(row=1, column=1, pady=8, padx=10, sticky="ew")
        self.entry_pass = ctk.CTkEntry(
            frame_pass, width=280, height=40,
            font=ctk.CTkFont(size=13), show="•"
        )
        self.entry_pass.pack(side="left", padx=(0, 5))
        self.btn_eye_pass = ctk.CTkButton(
            frame_pass, text="👁", width=40, height=40,
            command=self._toggle_main, fg_color="#2d6a4f"
        )
        self.btn_eye_pass.pack(side="left")

        # Пароль 2
        ctk.CTkLabel(
            self, text="Подтвердите:",
            font=ctk.CTkFont(size=12, weight="bold"),
            text_color="#7ec8e3"
        ).grid(row=2, column=0, sticky="w", pady=8, padx=10)
        frame_pass2 = ctk.CTkFrame(self, fg_color="transparent")
        frame_pass2.grid(row=2, column=1, pady=8, padx=10, sticky="ew")
        self.entry_pass_confirm = ctk.CTkEntry(
            frame_pass2, width=280, height=40,
            font=ctk.CTkFont(size=13), show="•"
        )
        self.entry_pass_confirm.pack(side="left", padx=(0, 5))
        self.btn_eye_confirm = ctk.CTkButton(
            frame_pass2, text="👁", width=40, height=40,
            command=self._toggle_confirm, fg_color="#2d6a4f"
        )
        self.btn_eye_confirm.pack(side="left")

        # ФИО
        self.label_fio = ctk.CTkLabel(
            self, text="ФИО:",
            font=ctk.CTkFont(size=12, weight="bold"),
            text_color="#7ec8e3"
        )
        self.label_fio.grid(row=3, column=0, sticky="w", pady=8, padx=10)
        self.entry_fio = ctk.CTkEntry(
            self, width=350, height=40,
            font=ctk.CTkFont(size=13),
            placeholder_text="Иванов Иван Иванович"
        )
        self.entry_fio.grid(row=3, column=1, pady=8, padx=10)

        # Дата
        self.label_dob = ctk.CTkLabel(
            self, text="Дата рождения:",
            font=ctk.CTkFont(size=12, weight="bold"),
            text_color="#7ec8e3"
        )
        self.label_dob.grid(row=4, column=0, sticky="w", pady=8, padx=10)
        self.entry_dob = ctk.CTkEntry(
            self, width=350, height=40,
            font=ctk.CTkFont(size=13),
            placeholder_text="ДД.ММ.ГГГГ"
        )
        self.entry_dob.grid(row=4, column=1, pady=8, padx=10)

        self.set_mode("login")

    def _toggle_main(self):
        show = "" if self.btn_eye_pass.cget("text") == "👁" else "•"
        self.entry_pass.configure(show=show)
        self.btn_eye_pass.configure(text="🙈" if show == "" else "👁")

    def _toggle_confirm(self):
        show = "" if self.btn_eye_confirm.cget("text") == "👁" else "•"
        self.entry_pass_confirm.configure(show=show)
        self.btn_eye_confirm.configure(text="🙈" if show == "" else "👁")

    def set_mode(self, mode):
        if mode == "register":
            self.label_fio.grid()
            self.entry_fio.grid()
            self.label_dob.grid()
            self.entry_dob.grid()
        else:
            self.label_fio.grid_remove()
            self.entry_fio.grid_remove()
            self.label_dob.grid_remove()
            self.entry_dob.grid_remove()

    def get_login(self):
        return self.entry_login.get().strip()

    def get_password(self):
        return self.entry_pass.get().strip()

    def get_password_confirm(self):
        return self.entry_pass_confirm.get().strip()

    def get_fio(self):
        return self.entry_fio.get().strip()

    def get_dob(self):
        return self.entry_dob.get().strip()
