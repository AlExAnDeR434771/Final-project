# Форма ввода данных (Логин, Пароль, ФИО, Дата)
import customtkinter as ctk


class LoginForm(ctk.CTkFrame):
    def __init__(self, master):
        super().__init__(master, fg_color="#0d2137")

        # Поля ввода
        ctk.CTkLabel(self, text="Логин:", font=ctk.CTkFont(size=12, weight="bold"), text_color="#7ec8e3").grid(row=0,
                                                                                                               column=0,
                                                                                                               sticky="w",
                                                                                                               pady=8,
                                                                                                               padx=10)
        self.entry_login = ctk.CTkEntry(self, width=300, height=35, font=ctk.CTkFont(size=12))
        self.entry_login.grid(row=0, column=1, pady=8, padx=10)

        ctk.CTkLabel(self, text="Пароль:", font=ctk.CTkFont(size=12, weight="bold"), text_color="#7ec8e3").grid(row=1,
                                                                                                                column=0,
                                                                                                                sticky="w",
                                                                                                                pady=8,
                                                                                                                padx=10)

        # Фрейм для пароля с кнопкой "глаз"
        frame_pass = ctk.CTkFrame(self, fg_color="transparent")
        frame_pass.grid(row=1, column=1, pady=8, padx=10, sticky="ew")
        self.entry_pass = ctk.CTkEntry(frame_pass, width=230, height=35, font=ctk.CTkFont(size=12), show="•")
        self.entry_pass.pack(side="left", padx=(0, 5))
        self.btn_eye = ctk.CTkButton(frame_pass, text="👁", width=35, height=35, command=self._toggle_password,
                                     fg_color="#2d6a4f")
        self.btn_eye.pack(side="left")

        ctk.CTkLabel(self, text="Подтвердите пароль:", font=ctk.CTkFont(size=12, weight="bold"),
                     text_color="#7ec8e3").grid(row=2, column=0, sticky="w", pady=8, padx=10)
        self.entry_pass_confirm = ctk.CTkEntry(self, width=300, height=35, font=ctk.CTkFont(size=12), show="•")
        self.entry_pass_confirm.grid(row=2, column=1, pady=8, padx=10)

        # Поля для регистрации (изначально скрыты)
        self.label_fio = ctk.CTkLabel(self, text="ФИО (полностью):", font=ctk.CTkFont(size=12, weight="bold"),
                                      text_color="#7ec8e3")
        self.label_fio.grid(row=3, column=0, sticky="w", pady=8, padx=10)
        self.entry_fio = ctk.CTkEntry(self, width=300, height=35, font=ctk.CTkFont(size=12),
                                      placeholder_text="Иванов Иван Иванович")
        self.entry_fio.grid(row=3, column=1, pady=8, padx=10)

        self.label_dob = ctk.CTkLabel(self, text="Дата рождения:", font=ctk.CTkFont(size=12, weight="bold"),
                                      text_color="#7ec8e3")
        self.label_dob.grid(row=4, column=0, sticky="w", pady=8, padx=10)
        self.entry_dob = ctk.CTkEntry(self, width=300, height=35, font=ctk.CTkFont(size=12),
                                      placeholder_text="ДД.ММ.ГГГГ")
        self.entry_dob.grid(row=4, column=1, pady=8, padx=10)

        # Изначально режим входа (скрываем лишнее)
        self.set_mode("login")

    def _toggle_password(self):
        show = "" if self.btn_eye.cget("text") == "👁" else "•"
        self.entry_pass.configure(show=show)
        self.entry_pass_confirm.configure(show=show)
        self.btn_eye.configure(text="🙈" if show == "" else "👁")

    def set_mode(self, mode):
        """Показывает или скрывает поля регистрации"""
        if mode == "register":
            self.label_fio.grid()
            self.entry_fio.grid()
            self.label_dob.grid()
            self.entry_dob.grid()
        else:
            self.label_fio.grid_remove()
            self.entry_fio.grid_remove()
            self.label_dob.grid_remove()
            self.entry_dob.grid_remove()

    # Методы получения данных
    def get_login(self):
        return self.entry_login.get().strip()

    def get_password(self):
        return self.entry_pass.get().strip()

    def get_password_confirm(self):
        return self.entry_pass_confirm.get().strip()

    def get_fio(self):
        return self.entry_fio.get().strip()

    def get_dob(self):
        return self.entry_dob.get().strip()

    def clear(self):
        self.entry_login.delete(0, 'end')
        self.entry_pass.delete(0, 'end')
        self.entry_pass_confirm.delete(0, 'end')
        self.entry_fio.delete(0, 'end')
        self.entry_dob.delete(0, 'end')
