"""Шапка окна"""
import customtkinter as ctk

class Header(ctk.CTkFrame):
    def __init__(self, master, user, on_logout):
        super().__init__(master, fg_color="#0d2137", height=60)
        self.pack_propagate(False)
        ctk.CTkLabel(self, text=f"👤 {user.get('fio', user['login'])}", text_color="#7ec8e3", font=ctk.CTkFont(size=16, weight="bold")).pack(side="left", padx=20)
        ctk.CTkButton(self, text="🚪 Выйти", command=on_logout, width=100, height=35, fg_color="#c75b5b").pack(side="right", padx=20)
