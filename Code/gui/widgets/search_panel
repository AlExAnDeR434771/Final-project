# Панель управления поиском
import customtkinter as ctk


class SearchPanel(ctk.CTkFrame):
    def __init__(self, master, on_filters, on_search):
        super().__init__(master, height=60, fg_color="#1a3a52")
        self.pack_propagate(False)

        self.btn_filters = ctk.CTkButton(self, text="🎛️ Фильтры", command=on_filters, width=140, height=35,
                                         fg_color="#2d6a4f")
        self.btn_filters.pack(side="left", padx=20)

        self.btn_search = ctk.CTkButton(self, text="▶️ Поиск", command=on_search, width=120, height=35,
                                        fg_color="#1b4332")
        self.btn_search.pack(side="left", padx=10)

        self.label_info = ctk.CTkLabel(self, text="Фильтр: не выбран", text_color="#7ec8e3")
        self.label_info.pack(side="left", padx=20)

    def update_filter_label(self, text):
        self.label_info.configure(text=f"Фильтр: {text}")
