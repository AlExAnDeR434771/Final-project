# Виджет таблицы результатов (Темная тема + Перенос строк)
import customtkinter as ctk
from tkinter import ttk
from urllib.parse import urlparse

class OlympiadTable(ctk.CTkFrame):
    COLUMNS = [
        ("№", 60, "center"),
        ("name", 400, "w"),
        ("desc", 450, "w"),
        ("url", 300, "w"),
    ]

    def __init__(self, parent, **kwargs):
        super().__init__(parent, **kwargs)
        self._create_treeview()

    def _create_treeview(self):
        container = ctk.CTkFrame(self, fg_color="transparent")
        container.pack(fill="both", expand=True)

        style = ttk.Style()
        style.theme_use('default')

        style.configure(
            "Treeview.Heading",
            font=("Arial", 13, "bold"),
            background="#1a3a52",
            foreground="#7ec8e3",
            padding=10
        )

        style.configure(
            "Treeview",
            font=("Arial", 11),
            rowheight=60,
            background="#0d2137",
            foreground="#7ec8e3",
            fieldbackground="#0d2137",
            borderwidth=0
        )

        style.map(
            "Treeview",
            background=[('selected', '#2d6a4f')],
            foreground=[('selected', '#ffffff')]
        )

        self.tree = ttk.Treeview(
            container,
            columns=[col[0] for col in self.COLUMNS],
            show="headings",
            height=12
        )

        for col_id, width, anchor in self.COLUMNS:
            self.tree.heading(col_id, text=self._get_header_text(col_id), anchor="center")
            self.tree.column(col_id, width=width, anchor=anchor)

        scrollbar = ttk.Scrollbar(container, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        self.tree.tag_configure('oddrow', background='#0d2137')
        self.tree.tag_configure('evenrow', background='#0a1a2d')

    def _get_header_text(self, col_id: str) -> str:
        headers = {
            "№": "№",
            "name": "Название олимпиады",
            "desc": "Описание",
            "url": "Сайт"
        }
        return headers.get(col_id, col_id)

    def show_empty_message(self, message: str = "🔍 Ничего не найдено"):
        self.tree.delete(*self.tree.get_children())
        self.tree.insert(
            "", "end",
            values=("", f"\n\n{message}\n\n", "", ""),
            tags=('empty',)
        )
        self.tree.tag_configure(
            'empty',
            background='#1a3a52',
            foreground='#4a9eff',
            font=("Arial", 16, "bold")
        )
        self.tree.column("name", width=0, stretch=False)
        self.tree.column("url", width=0, stretch=False)
        self.tree.column("№", width=0, stretch=False)
        self.tree.column("desc", width=800, anchor="center")

    def load_data(self, olympiads: list[tuple]):
        self.tree.delete(*self.tree.get_children())
        for col_id, width, anchor in self.COLUMNS:
            self.tree.column(col_id, width=width, anchor=anchor)

        for i, (name, desc, url) in enumerate(olympiads, 1):
            desc_line1 = desc[:80] if len(desc) > 80 else desc
            desc_line2 = desc[80:160] if len(desc) > 80 else ""
            desc_formatted = f"{desc_line1}\n{desc_line2}" if desc_line2 else desc_line1

            name_line1 = name[:50] if len(name) > 50 else name
            name_line2 = name[50:100] if len(name) > 50 else ""
            name_formatted = f"{name_line1}\n{name_line2}" if name_line2 else name_line1

            url_display = self._format_url(url)
            tag = 'oddrow' if i % 2 == 1 else 'evenrow'

            self.tree.insert(
                "", "end",
                values=(i, name_formatted, desc_formatted, url_display),
                tags=(tag,)
            )

    def _format_url(self, url: str) -> str:
        if not url or url in ("Не найдено", "Ошибка поиска"):
            return "—"
        try:
            return urlparse(url).netloc.replace("www.", "")
        except Exception:
            return url[:30] + "..."

    def clear(self):
        self.tree.delete(*self.tree.get_children())
