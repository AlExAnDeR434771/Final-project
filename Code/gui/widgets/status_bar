"""Строка состояния"""
import customtkinter as ctk

class StatusBar(ctk.CTkFrame):
    def __init__(self, master):
        super().__init__(master, fg_color="#0d2137", height=35)
        self.pack_propagate(False)
        self.lbl = ctk.CTkLabel(self, text="Готово", text_color="#7ec8e3", font=ctk.CTkFont(size=13))
        self.lbl.pack(fill="x", padx=15)
    def set(self, txt): self.lbl.configure(text=txt)
