# Шапка главного окна
import customtkinter as ctk

class DashboardHeader(ctk.CTkFrame):
    def __init__(self, master, user: dict, on_logout):
        super().__init__(master, height=60, fg_color="#0d2137")
        self.pack_propagate(False)
        fio = user.get('fio', user.get('login', 'Пользователь'))
        ctk.CTkLabel(self, text=f"👋 {fio}", font=ctk.CTkFont(size=18, weight="bold"),
                     text_color="#7ec8e3").pack(side="left", padx=20)
        ctk.CTkButton(self, text="🚪 Выйти", command=on_logout, width=100, height=35,
                      fg_color="#c75b5b").pack(side="right", padx=20)
