"""Окно входа/регистрации"""
import customtkinter as ctk
from gui.widgets.login_form import LoginForm

class LoginWindow:
    def __init__(self, parent, on_success, auth):
        self.parent, self.on_success, self.auth = parent, on_success, auth
        self.frame = ctk.CTkFrame(parent, fg_color="#1a3a52")
        self.frame.pack(fill="both", expand=True)
        self._build()

    def _build(self):
        ctk.CTkLabel(self.frame, text="🏆 SSOR", font=ctk.CTkFont(size=42, weight="bold"), text_color="#4a9eff").pack(pady=30)

        self.form = LoginForm(self.frame)
        self.form.pack(pady=10, padx=60, fill="x")

        self.submit_btn = ctk.CTkButton(self.frame, text="🔑 ВОЙТИ", command=self._submit, width=220, height=45, fg_color="#2d6a4f", font=ctk.CTkFont(size=14, weight="bold"))
        self.submit_btn.pack(pady=20)

        ctk.CTkButton(self.frame, text="🔄 Переключить режим", command=self._toggle_mode, width=160, height=35, fg_color="transparent", border_width=1, border_color="#4a9eff").pack()

        self.msg = ctk.CTkLabel(self.frame, text="", text_color="#ffffff", font=ctk.CTkFont(size=13))
        self.msg.pack(pady=10)

    def _toggle_mode(self):
        self.form.toggle()
        self.submit_btn.configure(text="✚ ЗАРЕГИСТРИРОВАТЬСЯ" if self.form.mode == "register" else "🔑 ВОЙТИ")
        self.msg.configure(text="")

    def _submit(self):
        self.msg.configure(text="")
        data = self.form.get_data()

        if self.form.mode == "login":
            res = self.auth.login(data["login"], data["password"])
        else:
            res = self.auth.register(
                login=data["login"],
                pwd=data["password"],
                confirm=data["confirm"],
                fio=data["fio"],
                dob=data["dob"],
                agreement=data["agreement"]
            )

        if res["success"]:
            self.msg.configure(text="✅ Успешно!", text_color="#4ade80")
            self.frame.after(600, lambda: self.on_success(res))
        else:
            self.msg.configure(text=res["message"], text_color="#f87171")
