# Сервис управления профилем пользователя
from crypto.encrypt import decrypt_kuznyechik
from database.db_users import get_user_data

class ProfileService:
    def load_fio(self, login: str) -> str:
        try:
            fio_enc = get_user_data(login, "fullname_enc")
            return decrypt_kuznyechik(fio_enc) if fio_enc else ""
        except: return ""
