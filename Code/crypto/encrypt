# Шифрование данных (Кузнечик ГОСТ + AES Fallback)
import base64
import hashlib
from config import KUZNECHIK_KEY, KUZNECHIK_IV

def _pad(data: bytes, block_size: int = 16) -> bytes:
    pad_len = block_size - len(data) % block_size
    return data + bytes([pad_len] * pad_len)

def encrypt_kuznyechik(text: str) -> str:
    try:
        import gostcrypto
        for mode in ['CBC', 'CTR', 'CFB']:
            try:
                cipher = gostcrypto.gostcipher.new('kuznechik', KUZNECHIK_KEY, mode=mode, iv=KUZNECHIK_IV)
                return base64.b64encode(cipher.encrypt(_pad(text.encode('utf-8')))).decode('utf-8')
            except Exception: continue
    except Exception: pass
    return _encrypt_fallback(text)

def decrypt_kuznyechik(encrypted_text: str) -> str:
    try:
        import gostcrypto
        decoded = base64.b64decode(encrypted_text)
        for mode in ['CBC', 'CTR', 'CFB']:
            try:
                cipher = gostcrypto.gostcipher.new('kuznechik', KUZNECHIK_KEY, mode=mode, iv=KUZNECHIK_IV)
                decrypted = cipher.decrypt(decoded)
                pad_len = decrypted[-1]
                res = decrypted[:-pad_len].decode('utf-8') if 1 <= pad_len <= 16\
                    else decrypted.decode('utf-8').rstrip()
                if res.strip(): return res.strip()
            except Exception: continue
    except Exception: pass
    return _decrypt_fallback(encrypted_text)

def _encrypt_fallback(text: str) -> str:
    try:
        from Crypto.Cipher import AES
        from Crypto.Util.Padding import pad
        key = hashlib.sha256(b'backup_key_123').digest()
        return base64.b64encode(AES.new(key, AES.MODE_CBC, b'0123456789abcdef').encrypt
                                (pad(text.encode(), 16))).decode()
    except: return base64.b64encode(text.encode('utf-8')).decode('utf-8')

def _decrypt_fallback(encrypted_text: str) -> str:
    try:
        from Crypto.Cipher import AES
        from Crypto.Util.Padding import unpad
        key = hashlib.sha256(b'backup_key_123').digest()
        return unpad(AES.new(key, AES.MODE_CBC,
                             b'0123456789abcdef').decrypt(base64.b64decode(encrypted_text)), 16).decode('utf-8')
    except:
        try: return base64.b64decode(encrypted_text).decode('utf-8')
        except: return "[ошибка расшифровки]"
