"""Извлечение данных из HTML"""
from bs4 import BeautifulSoup
import re

def extract_items(html: str) -> list:
    """
    Извлекает список олимпиад из HTML-страницы.
    Возвращает: [(название, описание, ссылка), ...]
    """
    if not html:
        return []

    soup = BeautifulSoup(html, "html.parser")
    items = []
    seen = set()

    # Ищем карточки олимпиад
    cards = soup.find_all("div", class_="activity-item")
    if not cards:
        cards = soup.find_all("div", class_="olimpiada")

    print(f"🔍 Найдено блоков: {len(cards)}")

    for card in cards:
        try:
            # Извлекаем полный текст
            full_text = card.get_text(separator=" ", strip=True)
            if len(full_text) < 20:
                continue

            # ✅ РАЗДЕЛЯЕМ НА НАЗВАНИЕ И ОПИСАНИЕ
            name, desc = _split_name_and_description(full_text)

            # Извлекаем ссылку
            link_tag = card.find("a", href=True)
            link = link_tag["href"] if link_tag else ""
            if link and not link.startswith("http"):
                link = f"https://olimpiada.ru{link}"

            # Уникальность
            name_key = name.lower()[:50]
            if name_key not in seen and len(name) > 10:
                items.append((name, desc, link))
                seen.add(name_key)

        except Exception as e:
            print(f"⚠️ Ошибка при разборе: {e}")
            continue

    print(f"✅ Извлечено олимпиад: {len(items)}")
    return items

def _split_name_and_description(text: str) -> tuple:
    """
    Разделяет текст на название и описание.
    Название — первое предложение/фраза до маркеров.
    Описание — всё остальное.
    """
    # Маркеры конца названия
    markers = [
        'Финал', 'Пригласительный', 'Опубликованы', 'Идет',
        'Ожидаются', 'Расписание', 'пройдет', 'проходит', 'начнется',
        'Регистрация', 'Заявки', 'для', 'класс'
    ]

    name = text
    desc = ""

    # Ищем маркер для разделения
    for marker in markers:
        idx = text.find(marker)
        if 20 < idx < 150:  # Название должно быть разумной длины
            name = text[:idx].strip()
            desc = text[idx:].strip()
            break

    # Если не нашли маркер — делим по длине
    if not desc and len(text) > 100:
        name = text[:80].strip()
        desc = text[80:].strip()

    # Очищаем
    name = ' '.join(name.split())[:120]
    desc = ' '.join(desc.split())[:180] if desc.strip() else "Описание отсутствует"

    return name, desc
