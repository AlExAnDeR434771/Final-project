"""Фильтрация олимпиад по критериям пользователя"""

def filter_olympiads(olympiads: list[tuple], filter_data: dict) -> list[tuple]:
    """
    Применяет фильтр пользователя к списку олимпиад

    Args:
        olympiads: Список (name, description, url)
        filter_data: Словарь с критериями {subject, grade, format, calendar, residential}

    Returns:
        Отфильтрованный список олимпиад
    """
    if not filter_data:
        return olympiads

    subject = filter_data.get("subject", "Все предметы").lower()
    grade = filter_data.get("grade", "Любой")
    format_type = filter_data.get("format", "Все")
    residential = filter_data.get("residential", False)

    filtered = []

    for name, desc, url in olympiads:
        text = f"{name} {desc}".lower()

        # ✅ Проверка предмета
        if subject != "все предметы" and subject not in text:
            continue

        # ✅ Проверка класса
        if grade != "Любой":
            if not _check_grade_match(text, grade):
                continue

        # ✅ Проверка формата
        if format_type == "Командные" and "команд" not in text and "командн" not in text:
            continue
        elif format_type == "Личные" and "личн" not in text:
            continue
        elif format_type == "Дистанционные" and "дистанц" not in text and "онлайн" not in text:
            continue

        # ✅ Проверка выездных школ
        if residential and "выезд" not in text and "смена" not in text:
            continue

        filtered.append((name, desc, url))

    return filtered


def _check_grade_match(text: str, grade: str) -> bool:
    """Проверяет соответствие класса"""
    # Точное совпадение
    if f"{grade} класс" in text:
        return True

    # Диапазон классов (например, "5-11 классы")
    if "классы" in text:
        import re
        ranges = re.findall(r'(\d+)\s*-\s*(\d+)', text)
        for start, end in ranges:
            if int(start) <= int(grade) <= int(end):
                return True

    # Универсальные олимпиады
    if "5-11" in text and 5 <= int(grade) <= 11:
        return True

    return False
