# Фильтрация олимпиад по параметрам
def filter_olympiads(olympiads: list[tuple], filter_dict: dict) -> list[tuple]:
    if not filter_dict:
        return olympiads

    subj = filter_dict.get("subject", "Все предметы").lower()
    grade = filter_dict.get("grade", "Любой")
    fmt = filter_dict.get("format", "Все")

    # Если все фильтры "Все" — возвращаем всё
    if subj == "все предметы" and grade == "Любой" and fmt == "Все":
        return olympiads

    filtered = []
    for name, desc, url in olympiads:
        txt = f"{name} {desc}".lower()

        # ✅ Проверка предмета
        subj_ok = subj == "все предметы" or subj in txt

        # ✅ Проверка класса (более строгая)
        if grade == "Любой":
            grade_ok = True
        else:
            # Точное совпадение: "11 класс"
            grade_ok = f"{grade} класс" in txt
            # Или диапазон: "10-11 классы", "5-11 классы"
            if not grade_ok:
                for range_text in ["5-11", "7-11", "8-11", "9-11", "10-11"]:
                    if range_text in txt and int(grade) >= int(range_text.split("-")[0]):
                        grade_ok = True
                        break

        # ✅ Проверка формата (если указан)
        fmt_ok = True
        if fmt == "Командные":
            fmt_ok = "команд" in txt or "командн" in txt
        elif fmt == "Личные":
            fmt_ok = "личн" in txt or "индивидуальн" in txt
        elif fmt == "Дистанционные":
            fmt_ok = "дистанцион" in txt or "онлайн" in txt or "online" in txt

        if subj_ok and grade_ok and fmt_ok:
            filtered.append((name, desc, url))

    print(f"✅ После фильтрации: {len(filtered)} (было {len(olympiads)})")
    return filtered
