# Извлечение данных из HTML-страницы
from bs4 import BeautifulSoup
from config import MAX_OLYMPIADS

def _split_name_and_desc(text: str) -> tuple[str, str]:
    name, desc = text, ""
    if '»' in text:
        parts = text.split('»', 1)
        if len(parts) == 2 and len(parts[0]) > 10: name, desc = parts[0].strip() + '»', parts[1].strip()
    if not desc or len(desc) < 10:
        for m in ['Финал', 'Пригласительный', 'Опубликованы', 'Идет', 'Ожидаются', 'Расписание', 'пройдет', 'начнется']:
            idx = text.find(m)
            if 30 < idx < 120: name, desc = text[:idx].strip(), text[idx:].strip(); break
    if not desc and len(text) > 100: name, desc = text[:80].strip(), text[80:].strip()
    return ' '.join(name.split())[:120], ' '.join(desc.split())[:180] if desc.strip() else "Описание отсутствует"

def extract_olympiads(soup: BeautifulSoup) -> list[tuple]:
    olympiads, seen = [], set()
    for card in soup.find_all('div', class_='olimpiada'):
        try:
            info = card.find('div', class_='o-info')
            if not info: continue
            full = info.get_text(separator=' ', strip=True)
            if len(full) < 20: continue
            n, d = _split_name_and_desc(full)
            if n.lower() not in seen: olympiads.append((n, d, "")); seen.add(n.lower())
        except: continue
    print(f"✅ Извлечено: {len(olympiads)}")
    return olympiads[:MAX_OLYMPIADS]
