# Главная функция парсинга олимпиад
# Оркестратор парсинга: кэш → запрос → извлечение → фильтрация → сохранение
import requests
from bs4 import BeautifulSoup
from config import OLIMPIADA_ACTIVITIES, REQUEST_TIMEOUT, MAX_OLYMPIADS
from database.db_ol import init, save_olympiads, get_olympiads
from .url_builder import build_activities_url
from .extractor import extract_olympiads
from .filter import filter_olympiads

def parse_olympiads(filter_tag: str, filter_dict: dict = None) -> list[tuple]:
    init()
    print(f"📥 Парсинг для: {filter_tag}")

    cached = get_olympiads(filter_tag)
    if len(cached) > 0:
        print(f"💾 Кэш: {len(cached)} олимпиад")
        return cached
    if cached is not None and len(cached) == 0:
        print("💾 Кэш: пусто (уже искали)")
        return []

    url = build_activities_url(filter_dict) if filter_dict else OLIMPIADA_ACTIVITIES
    headers = {'User-Agent': 'Mozilla/5.0', 'Accept-Language': 'ru-RU'}

    try:
        resp = requests.get(url, headers=headers, timeout=REQUEST_TIMEOUT)
        resp.raise_for_status()
        if 'activities' not in resp.url:
            resp = requests.get(OLIMPIADA_ACTIVITIES, headers=headers, timeout=REQUEST_TIMEOUT)

        soup = BeautifulSoup(resp.text, 'html.parser')
        all_olympiads = extract_olympiads(soup)
        olympiads = filter_olympiads(all_olympiads, filter_dict)

        if len(olympiads) == 0:
            print("ℹ️ Ничего не найдено по фильтру.")
            save_olympiads(filter_tag, [])
            return []

        if len(olympiads) < 3 and filter_dict:
            print("⚠️ Мало результатов, мягкий поиск...")

        save_olympiads(filter_tag, [(n, d, "") for n, d, _ in olympiads])
        return olympiads

    except Exception as e:
        print(f"❌ Ошибка: {e}")
        return []
