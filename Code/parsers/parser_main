# Главная функция парсинга олимпиад
import requests
from bs4 import BeautifulSoup
from config import OLIMPIADA_ACTIVITIES, REQUEST_TIMEOUT, MAX_OLYMPIADS
from database.db_ol import init, save_olympiads, get_olympiads
from .url_builder import build_activities_url
from .extractor import extract_olympiads
from .filter import filter_olympiads


def parse_olympiads(filter_tag: str, filter_dict: dict = None) -> list[tuple]:

#    Основная функция парсинга:
#    1. Проверяет кэш
#    2. Делает запрос к сайту
#    3. Извлекает олимпиады
#    4. Фильтрует по параметрам
#    5. Сохраняет в кэш

    init()
    print(f"📥 Парсинг для: {filter_tag}")

# 1. Проверяем кэш
    cached = get_olympiads(filter_tag)
    if cached and len(cached) >= 3:
        print(f"💾 Кэш: {len(cached)} олимпиад")
        return cached

# 2. Формируем URL и делаем запрос
    url = build_activities_url(filter_dict) if filter_dict else OLIMPIADA_ACTIVITIES
    headers = {'User-Agent': 'Mozilla/5.0', 'Accept-Language': 'ru-RU,ru;q=0.9'}

    try:
        resp = requests.get(url, headers=headers, timeout=REQUEST_TIMEOUT)
        resp.raise_for_status()

        # Если редирект — пробуем базовый URL
        if 'activities' not in resp.url:
            print("⚠️ Редирект, пробуем базовый URL...")
            resp = requests.get(OLIMPIADA_ACTIVITIES, headers=headers, timeout=REQUEST_TIMEOUT)

# 3. Извлекаем олимпиады
        soup = BeautifulSoup(resp.text, 'html.parser')
        all_olympiads = extract_olympiads(soup)

# 4. Фильтруем результаты
        olympiads = filter_olympiads(all_olympiads, filter_dict)

# 5. Фолбэк: если мало результатов, пробуем расширенный поиск
        if len(olympiads) < 3 and filter_dict and filter_dict.get("subject") != "Все предметы":
            print("⚠️ Мало результатов, пробуем расширенный поиск...")
            resp2 = requests.get(OLIMPIADA_ACTIVITIES, headers=headers, timeout=REQUEST_TIMEOUT)
            all_res = extract_olympiads(BeautifulSoup(resp2.text, 'html.parser'))

# Мягкая фильтрация только по предмету
            subj = filter_dict["subject"].lower()
            soft_filtered = [o for o in all_res if subj in o[0].lower()]
            olympiads = soft_filtered[:MAX_OLYMPIADS] if soft_filtered else all_res[:20]

# 6. Сохраняем в кэш
        if olympiads:
            print(f"💾 Сохраняем в кэш: {len(olympiads)} записей")
            save_olympiads(filter_tag, [(n, d, "") for n, d, _ in olympiads])
        else:
            print("⚠️ Нет данных, используем общие...")
            fallback = get_olympiads("П:Все предметы|К:Любой|Д:Когда угодно|Ф:Все|В:Нет")
            olympiads = fallback[:15] if fallback else [("Тест", "Данные", "")]

    except Exception as e:
        print(f"❌ Ошибка: {e}")
        fb = get_olympiads("П:Все предметы|К:Любой|Д:Когда угодно|Ф:Все|В:Нет")
        olympiads = fb[:10] if fb else [("Ошибка", "Проверьте интернет", "")]

    return olympiads
