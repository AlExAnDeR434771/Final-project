# Построение URL для запросов к olimpiada.ru
from urllib.parse import urlencode
from config import OLIMPIADA_ACTIVITIES


def build_activities_url(filter_dict: dict) -> str:
# Формирует URL с параметрами фильтрации
    params = {}

# Предмет
    subj = filter_dict.get("subject", "Все предметы")
    if subj != "Все предметы":
        params["subject"] = subj.lower()

# Класс
    grade = filter_dict.get("grade", "Любой")
    if grade != "Любой":
        params["grade"] = grade

# Формат
    fmt = filter_dict.get("format", "Все")
    if fmt == "Командные":
        params["team"] = "1"
    elif fmt == "Личные":
        params["individual"] = "1"
    elif fmt == "Дистанционные":
        params["online"] = "1"

# Выездные школы
    if filter_dict.get("residential"):
        params["residential"] = "1"

# Календарь
    cal = filter_dict.get("calendar", "Когда угодно")
    if cal == "Сейчас":
        params["active"] = "1"

    query = urlencode(params, encoding='utf-8')
    url = f"{OLIMPIADA_ACTIVITIES}?{query}" if query else OLIMPIADA_ACTIVITIES

    print(f"🔗 Запрос: {url}")
    return url
