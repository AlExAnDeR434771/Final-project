"""Генерация URL запросов"""
from urllib.parse import urlencode
from config import OLIMPIADA_URL


def build_url(filters: dict) -> str:
    base = OLIMPIADA_URL
    params = {}

    subject = filters.get("subject", "Все предметы")
    if subject and subject != "все предметы":
        # ✅ Используем уже очищенный subject
        params["subject"] = subject

    if filters.get("residential"):
        params["residential"] = "1"

    query = urlencode(params, encoding='utf-8')
    return f"{base}?{query}" if query else base
